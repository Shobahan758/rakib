APP_NAME="Furniture Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://furniturepolish.solutionmartbd.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_database_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
MAIL_MAILER=log
ORDER_FAKE_RISK_THRESHOLD=70
